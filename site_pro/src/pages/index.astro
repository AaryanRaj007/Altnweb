---
import MainLayout from "../layouts/MainLayout.astro";
import Separator from "../components/Separator.astro";
---

<style>
    p {
        margin-bottom: 0;
    }
</style>

<MainLayout
    title="altn"
    description="33 self-authored color grading LUTs for trekking and drone footage. 65-point precision, DaVinci Resolve native."
>
    <!-- Centered Hero Section -->
    <section class="w-full flex flex-col items-center justify-center text-center mt-16 sm:mt-32 mb-24 sm:mb-40 animate-fade-in-up">
        <h1 class="text-5xl sm:text-7xl leading-tight text-white mb-8 text-balance max-w-4xl">
            your footage, your grade,<br />your problem.
        </h1>
        
        <div class="flex flex-row items-center justify-center gap-6 mt-4">
            <a
                href="/luts"
                class="px-8 py-3.5 rounded-xl bg-white text-black hover:bg-gray-200 hover:scale-[1.02] active:scale-95 font-bold text-lg !no-underline transition-all shadow-[0_0_20px_rgba(255,255,255,0.2)]"
            >
                browse the pack
            </a>
            <a 
                href="/about" 
                class="text-sayso-text/70 hover:text-white font-medium text-lg underline underline-offset-4 decoration-sayso-text/30 hover:decoration-white/50 transition-all"
            >
                why these exist &rarr;
            </a>
        </div>
    </section>

    <div class="flex flex-col items-center gap-12 w-full">
        <Separator />
        <div class="w-full grid grid-cols-1 md:grid-cols-2 md:gap-12 gap-4">
            <div class="space-y-1">
                <h2>Self-authored</h2>
                <p>
                    Every LUT built from scratch on real footage. No third-party
                    licensing risk, no repacked presets.
                </p>
            </div>
            <div class="space-y-1">
                <h2>Two sources, one set</h2>
                <p>
                    Apple Log and DJI D-Log footage both work. Utility layer
                    normalizes to Rec.709 first, creative LUTs sit on top.
                </p>
            </div>
            <div class="space-y-1">
                <h2>65-point precision</h2>
                <p>
                    Every LUT is 65-point - no banding in sky gradients, no
                    stepping in smooth transitions. The reason drone footage
                    needs more than DJI's 33-point default.
                </p>
            </div>
            <div class="space-y-1">
                <h2>DaVinci native</h2>
                <p>
                    Standard .cube format. Drop into Resolve, Premiere, FCP, or
                    any editor that reads 3D LUTs. No plugins, no subscriptions.
                </p>
            </div>
        </div>

        <Separator />
        <div class="w-full">
            <h2 class="text-center mb-8">the set</h2>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
                <a href="/luts#natural" class="lut-card !no-underline group">
                    <div class="text-sayso-yellow font-bold text-lg">Natural</div>
                    <div class="text-sayso-text/50 text-sm">5 LUTs</div>
                    <div class="text-sayso-text/40 text-xs mt-1">baselines, warm, cool, protection, punch</div>
                </a>
                <a href="/luts#cinematic" class="lut-card !no-underline group">
                    <div class="text-sayso-yellow font-bold text-lg">Cinematic</div>
                    <div class="text-sayso-text/50 text-sm">8 LUTs</div>
                    <div class="text-sayso-text/40 text-xs mt-1">teal-orange, film, golden/blue hour, vintage</div>
                </a>
                <a href="/luts#mood" class="lut-card !no-underline group">
                    <div class="text-sayso-yellow font-bold text-lg">Mood</div>
                    <div class="text-sayso-text/50 text-sm">15 LUTs</div>
                    <div class="text-sayso-text/40 text-xs mt-1">brand, night, vintage, vlog, documentary</div>
                </a>
                <a href="/luts#drone" class="lut-card !no-underline group">
                    <div class="text-sayso-yellow font-bold text-lg">Drone</div>
                    <div class="text-sayso-text/50 text-sm">5 LUTs</div>
                    <div class="text-sayso-text/40 text-xs mt-1">haze, sky, terrain, water, sunset</div>
                </a>
            </div>
        </div>

        <Separator />

        <!-- Plugins Teaser Spotlight -->
        <div class="w-full rounded-2xl border border-sayso-text/10 bg-sayso-yellow/5 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="space-y-1 text-center sm:text-left">
                <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-sayso-yellow/15 text-sayso-yellow text-xs font-bold w-fit mb-1">
                    NEW WORKFLOW TOOL
                </div>
                <h2 class="!m-0 text-2xl sm:text-3xl">YouTube Media Importer</h2>
                <p class="text-sayso-text/60 text-sm max-w-xl !m-0">
                    Live YouTube browsing overlay right inside DaVinci Resolve. Download video & audio and import directly to Media Pool.
                </p>
            </div>
            <a
                href="/plugins"
                class="px-6 py-3 rounded-xl bg-white text-black hover:bg-gray-200 font-bold text-sm shrink-0 !no-underline transition-all hover:scale-[1.02] active:scale-95"
            >
                explore plugin &rarr;
            </a>
        </div>
    </div>
</MainLayout>
